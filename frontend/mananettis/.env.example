# Copy to .env (gitignored) for make d1-clear / make rollback. Shell exports win over this file.
# Token: Cloudflare → My Profile → API Tokens → Custom → Account · D1 · Edit (only this account).
CLOUDFLARE_API_TOKEN=
# The id in the dashboard URLs (dash.cloudflare.com/<account id>/...).
CLOUDFLARE_ACCOUNT_ID=
